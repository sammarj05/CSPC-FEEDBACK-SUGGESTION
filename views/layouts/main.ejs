<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="CSPC Suggestion and Feedback System — Submit and track feedback at Camarines Sur Polytechnic Colleges." />
  <title><%= title %></title>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Application Stylesheets -->
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/chat.css" />
</head>
<body>

  <%- include('../partials/navbar') %>

  <!-- Flash Messages -->
  <% if (flashSuccess && flashSuccess.length > 0) { %>
    <div class="flash flash--success" role="alert" aria-live="polite">
      <span class="flash__icon" aria-hidden="true">✓</span>
      <span><%- flashSuccess[0] %></span>
      <button class="flash__close" aria-label="Dismiss notification" onclick="this.parentElement.remove()">×</button>
    </div>
  <% } %>

  <% if (flashError && flashError.length > 0) { %>
    <div class="flash flash--error" role="alert" aria-live="assertive">
      <span class="flash__icon" aria-hidden="true">✕</span>
      <span><%= flashError[0] %></span>
      <button class="flash__close" aria-label="Dismiss notification" onclick="this.parentElement.remove()">×</button>
    </div>
  <% } %>

  <main id="main-content">
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <!-- Aizen AI Chat Widget -->
  <%- include('../partials/chat-widget') %>

  <script src="/js/main.js"></script>
  <script src="/js/chat.js"></script>
</body>
</html>
