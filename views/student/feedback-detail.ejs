<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
</head>
<body>
  <%- include('../partials/navbar', { activePage: 'my-feedback' }) %>

  <div class="page-header">
    <div class="container page-header__row">
      <div>
        <h1 class="page-header__title"><%= feedback.reference_number %></h1>
        <p class="page-header__subtitle"><%= feedback.subject %></p>
      </div>
      <a href="/feedback" class="btn btn--secondary btn--sm">← Back to My Submissions</a>
    </div>
  </div>

  <main class="container section" id="main-content">

    <!-- Flash messages -->
    <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
      <div class="flash flash--success" role="alert" aria-live="polite">
        <span aria-hidden="true">✓</span> <%- flashSuccess[0] %>
        <button class="flash__close" aria-label="Dismiss" onclick="this.parentElement.remove()">×</button>
      </div>
    <% } %>

    <div class="detail-layout">

      <!-- Left: Feedback info -->
      <div class="detail-main">

        <div class="detail-card">
          <h2 class="detail-card__title">Feedback Details</h2>
          <dl class="detail-list">
            <div class="detail-item">
              <dt>Reference Number</dt>
              <dd><code class="ref-num"><%= feedback.reference_number %></code></dd>
            </div>
            <div class="detail-item">
              <dt>Type</dt>
              <dd><span class="type-chip"><%= feedback.type.replace(/_/g,' ') %></span></dd>
            </div>
            <div class="detail-item">
              <dt>Category</dt>
              <dd><%= feedback.category_name %></dd>
            </div>
            <div class="detail-item">
              <dt>Priority</dt>
              <dd><%- include('../partials/priority-badge', { priority: feedback.priority }) %></dd>
            </div>
            <div class="detail-item">
              <dt>Current Status</dt>
              <dd><%- include('../partials/status-badge', { status: feedback.status }) %></dd>
            </div>
            <div class="detail-item">
              <dt>Submitted</dt>
              <dd>
                <time datetime="<%= feedback.created_at %>">
                  <%= new Date(feedback.created_at).toLocaleString('en-PH', { dateStyle:'long', timeStyle:'short' }) %>
                </time>
              </dd>
            </div>
            <% if (feedback.is_anonymous) { %>
            <div class="detail-item">
              <dt>Submission Mode</dt>
              <dd><span class="badge badge--anon">Anonymous</span></dd>
            </div>
            <% } %>
          </dl>
        </div>

        <div class="detail-card">
          <h2 class="detail-card__title">Description</h2>
          <div class="detail-description">
            <p><%= feedback.description %></p>
          </div>
        </div>

        <!-- Admin Responses -->
        <div class="detail-card">
          <h2 class="detail-card__title">Official Responses
            <% if (responses.length > 0) { %>
              <span class="badge badge--count"><%= responses.length %></span>
            <% } %>
          </h2>

          <% if (responses.length === 0) { %>
            <p class="empty-inline">No responses yet. Your feedback is under review.</p>
          <% } else { %>
            <div class="responses-list">
              <% responses.forEach(function(resp) { %>
                <div class="response-item">
                  <div class="response-item__header">
                    <span class="response-item__author">
                      <span class="response-item__badge" aria-hidden="true">🏛️</span>
                      CSPC Administration
                      <% if (resp.admin_name) { %><span class="response-item__name">— <%= resp.admin_name %></span><% } %>
                    </span>
                    <time class="response-item__date" datetime="<%= resp.created_at %>">
                      <%= new Date(resp.created_at).toLocaleString('en-PH', { dateStyle:'medium', timeStyle:'short' }) %>
                    </time>
                  </div>
                  <div class="response-item__body">
                    <p><%= resp.message %></p>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

      </div>

      <!-- Right: Status timeline -->
      <aside class="detail-sidebar" aria-label="Status timeline">
        <div class="detail-card">
          <h2 class="detail-card__title">Status Timeline</h2>

          <ol class="timeline" aria-label="Feedback status history">
            <% statusHistory.forEach(function(h, idx) { %>
              <li class="timeline__item <% if (idx === statusHistory.length - 1) { %>timeline__item--current<% } %>">
                <div class="timeline__dot" aria-hidden="true"></div>
                <div class="timeline__content">
                  <p class="timeline__status">
                    <%- include('../partials/status-badge', { status: h.new_status }) %>
                  </p>
                  <time class="timeline__date" datetime="<%= h.created_at %>">
                    <%= new Date(h.created_at).toLocaleString('en-PH', { dateStyle:'medium', timeStyle:'short' }) %>
                  </time>
                  <% if (h.note) { %>
                    <p class="timeline__note"><%= h.note %></p>
                  <% } %>
                </div>
              </li>
            <% }); %>
          </ol>
        </div>
      </aside>

    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
