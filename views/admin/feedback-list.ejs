<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
</head>
<body>
  <%- include('../partials/navbar', { activePage: 'admin-feedback' }) %>

  <div class="page-header page-header--admin">
    <div class="container">
      <h1 class="page-header__title">Feedback Management</h1>
      <p class="page-header__subtitle">
        Showing <%= feedbackList.length %> of <%= pagination.total %> records
      </p>
    </div>
  </div>

  <main class="container section" id="main-content">

    <!-- Flash -->
    <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
      <div class="flash flash--success" role="alert" aria-live="polite">✓ <%- flashSuccess[0] %>
        <button class="flash__close" aria-label="Dismiss" onclick="this.parentElement.remove()">×</button>
      </div>
    <% } %>
    <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
      <div class="flash flash--error" role="alert"><%= flashError[0] %>
        <button class="flash__close" aria-label="Dismiss" onclick="this.parentElement.remove()">×</button>
      </div>
    <% } %>

    <!-- Filters -->
    <form class="filter-form" action="/admin/feedback" method="GET" id="filterForm" role="search" aria-label="Filter feedback">
      <div class="filter-row">

        <div class="filter-group">
          <label class="filter-label" for="filterSearch">Search</label>
          <input
            type="search"
            id="filterSearch"
            name="search"
            class="form-input form-input--sm"
            value="<%= filters.search || '' %>"
            placeholder="Reference # or subject..."
            aria-label="Search by reference number or subject"
          />
        </div>

        <div class="filter-group">
          <label class="filter-label" for="filterStatus">Status</label>
          <select id="filterStatus" name="status" class="form-select form-select--sm">
            <option value="">All Statuses</option>
            <option value="submitted"    <%= filters.status === 'submitted'    ? 'selected' : '' %>>Submitted</option>
            <option value="under_review" <%= filters.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
            <option value="in_progress"  <%= filters.status === 'in_progress'  ? 'selected' : '' %>>In Progress</option>
            <option value="resolved"     <%= filters.status === 'resolved'     ? 'selected' : '' %>>Resolved</option>
            <option value="closed"       <%= filters.status === 'closed'       ? 'selected' : '' %>>Closed</option>
          </select>
        </div>

        <div class="filter-group">
          <label class="filter-label" for="filterCategory">Category</label>
          <select id="filterCategory" name="categoryId" class="form-select form-select--sm">
            <option value="">All Categories</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat.id %>" <%= filters.categoryId == cat.id ? 'selected' : '' %>><%= cat.name %></option>
            <% }); %>
          </select>
        </div>

        <div class="filter-group">
          <label class="filter-label" for="filterType">Type</label>
          <select id="filterType" name="type" class="form-select form-select--sm">
            <option value="">All Types</option>
            <option value="suggestion"       <%= filters.type === 'suggestion'       ? 'selected' : '' %>>Suggestion</option>
            <option value="complaint"        <%= filters.type === 'complaint'        ? 'selected' : '' %>>Complaint</option>
            <option value="concern"          <%= filters.type === 'concern'          ? 'selected' : '' %>>Concern</option>
            <option value="general_feedback" <%= filters.type === 'general_feedback' ? 'selected' : '' %>>General Feedback</option>
            <option value="appreciation"     <%= filters.type === 'appreciation'     ? 'selected' : '' %>>Appreciation</option>
          </select>
        </div>

        <div class="filter-group">
          <label class="filter-label" for="filterPriority">Priority</label>
          <select id="filterPriority" name="priority" class="form-select form-select--sm">
            <option value="">All Priorities</option>
            <option value="high"   <%= filters.priority === 'high'   ? 'selected' : '' %>>High</option>
            <option value="medium" <%= filters.priority === 'medium' ? 'selected' : '' %>>Medium</option>
            <option value="low"    <%= filters.priority === 'low'    ? 'selected' : '' %>>Low</option>
          </select>
        </div>

        <div class="filter-group filter-group--actions">
          <button type="submit" class="btn btn--primary btn--sm" id="filterApplyBtn">Apply</button>
          <a href="/admin/feedback" class="btn btn--ghost btn--sm" id="filterClearBtn">Clear</a>
        </div>

      </div>
    </form>

    <!-- Feedback Table -->
    <% if (feedbackList.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state__icon" aria-hidden="true">📭</div>
        <h2 class="empty-state__title">No feedback found</h2>
        <p class="empty-state__text">Try adjusting your filters.</p>
      </div>
    <% } else { %>

      <div class="table-wrapper" role="region" aria-label="Feedback records" tabindex="0">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Reference #</th>
              <th scope="col">Subject</th>
              <th scope="col">Student</th>
              <th scope="col">Category</th>
              <th scope="col">Type</th>
              <th scope="col">Priority</th>
              <th scope="col">Status</th>
              <th scope="col">Date</th>
              <th scope="col"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% feedbackList.forEach(function(fb) { %>
              <tr>
                <td><code class="ref-num"><%= fb.reference_number %></code></td>
                <td class="td--subject"><%= fb.subject %></td>
                <td>
                  <% if (fb.is_anonymous) { %>
                    <span class="badge badge--anon">Anonymous</span>
                  <% } else { %>
                    <%= fb.student_name || '—' %>
                  <% } %>
                </td>
                <td><%= fb.category_name %></td>
                <td><span class="type-chip"><%= fb.type.replace(/_/g,' ') %></span></td>
                <td><%- include('../partials/priority-badge', { priority: fb.priority }) %></td>
                <td><%- include('../partials/status-badge', { status: fb.status }) %></td>
                <td>
                  <time datetime="<%= fb.created_at %>">
                    <%= new Date(fb.created_at).toLocaleDateString('en-PH', { year:'numeric', month:'short', day:'numeric' }) %>
                  </time>
                </td>
                <td><a href="/admin/feedback/<%= fb.id %>" class="table-link" aria-label="Manage feedback <%= fb.reference_number %>">Manage</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (pagination.totalPages > 1) { %>
        <nav class="pagination" aria-label="Pagination">
          <% if (pagination.currentPage > 1) { %>
            <a href="?page=<%= pagination.currentPage - 1 %>&status=<%= filters.status || '' %>&categoryId=<%= filters.categoryId || '' %>&type=<%= filters.type || '' %>&priority=<%= filters.priority || '' %>&search=<%= filters.search || '' %>"
               class="pagination__link" aria-label="Previous page">← Previous</a>
          <% } %>
          <span class="pagination__info">Page <%= pagination.currentPage %> of <%= pagination.totalPages %></span>
          <% if (pagination.currentPage < pagination.totalPages) { %>
            <a href="?page=<%= pagination.currentPage + 1 %>&status=<%= filters.status || '' %>&categoryId=<%= filters.categoryId || '' %>&type=<%= filters.type || '' %>&priority=<%= filters.priority || '' %>&search=<%= filters.search || '' %>"
               class="pagination__link" aria-label="Next page">Next →</a>
          <% } %>
        </nav>
      <% } %>

    <% } %>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
