<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
</head>
<body>
  <%- include('../partials/navbar', { activePage: 'admin-chat' }) %>

  <div class="page-header page-header--admin">
    <div class="container">
      <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:var(--space-4);">
        <div>
          <h1 class="page-header__title">💬 Conversation #<%= conv.id %></h1>
          <p class="page-header__subtitle">
            <% if (conv.user_name) { %>
              <strong><%= conv.user_name %></strong> &lt;<%= conv.user_email %>&gt;
            <% } else { %>
              Guest / Anonymous user
            <% } %>
            &nbsp;&middot;&nbsp;
            <span class="chat-status-badge chat-status-badge--<%= conv.status %>"><%= conv.status %></span>
          </p>
        </div>
        <a href="/admin/chat" class="btn btn--outline" style="font-size:0.875rem;">
          ← All Conversations
        </a>
      </div>
    </div>
  </div>

  <main class="container section" id="main-content">

    <!-- Flash messages -->
    <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
      <div class="flash flash--success" role="alert" aria-live="polite">✓ <%- flashSuccess[0] %>
        <button class="flash__close" aria-label="Dismiss" onclick="this.parentElement.remove()">×</button>
      </div>
    <% } %>
    <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
      <div class="flash flash--error" role="alert"><%= flashError[0] %>
        <button class="flash__close" aria-label="Dismiss" onclick="this.parentElement.remove()">×</button>
      </div>
    <% } %>

    <!-- Thread -->
    <div class="admin-chat-thread" id="adminThread">
      <% if (!messages || messages.length === 0) { %>
        <p style="text-align:center; color:var(--color-text-muted); font-size:0.875rem; padding:var(--space-8);">
          No messages yet in this conversation.
        </p>
      <% } else { %>
        <% messages.forEach(function(m) { %>
          <div class="admin-thread-msg admin-thread-msg--<%= m.sender_type %>">
            <div class="admin-thread-msg__sender">
              <%= m.sender_type === 'ai' ? '🤖 Aizen AI' : m.sender_type === 'admin' ? '👤 Administrator' : '🎓 User' %>
            </div>
            <div class="admin-thread-msg__bubble"><%= m.message %></div>
            <div class="admin-thread-msg__time">
              <%= new Date(m.created_at).toLocaleString('en-PH', { dateStyle:'medium', timeStyle:'short' }) %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Admin reply form -->
    <% if (conv.status !== 'closed') { %>
      <div style="margin-top: var(--space-6);">
        <h2 style="font-size:1rem; font-weight:600; margin:0 0 var(--space-3);">Reply as Administrator</h2>

        <div style="display:flex; gap:0.75rem; align-items:flex-end;">
          <textarea
            id="adminReplyInput"
            placeholder="Type your reply to the user…"
            rows="3"
            maxlength="1000"
            style="flex:1; border:1.5px solid var(--color-border); border-radius:var(--radius); padding:0.6rem 0.75rem;
                   font-family:var(--font-sans); font-size:0.875rem; resize:vertical; color:var(--color-text);
                   background:var(--color-bg); transition:border-color 150ms ease;"
            onfocus="this.style.borderColor='var(--color-primary)'; this.style.background='#fff';"
            onblur="this.style.borderColor='var(--color-border)'; this.style.background='var(--color-bg)';"
          ></textarea>
          <button
            id="adminSendBtn"
            class="btn btn--primary"
            style="height:2.6rem; white-space:nowrap;"
            onclick="adminReply()"
          >Send Reply</button>
        </div>

        <div style="margin-top:var(--space-3); display:flex; gap:0.5rem; flex-wrap:wrap;">
          <button
            class="btn btn--outline"
            style="font-size:0.8rem;"
            onclick="closeConversation()"
            id="closeConvBtn"
          >Mark as Closed</button>
          <span style="font-size:0.75rem; color:var(--color-text-muted); align-self:center;">
            Replies are labeled <strong>Administrator</strong> and are clearly separated from Aizen AI messages.
          </span>
        </div>
      </div>
    <% } else { %>
      <div style="margin-top:var(--space-4); padding:var(--space-3) var(--space-4); background:var(--color-bg-alt);
                  border-radius:var(--radius); color:var(--color-text-muted); font-size:0.875rem; text-align:center;">
        This conversation is <strong>closed</strong>. No further replies can be sent.
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>

  <script>
  const CONV_ID = <%= conv.id %>;

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  async function adminReply() {
    const input  = document.getElementById('adminReplyInput');
    const btn    = document.getElementById('adminSendBtn');
    const thread = document.getElementById('adminThread');
    const msg    = input.value.trim();
    if (!msg) return;

    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      const res = await fetch('/admin/chat/' + CONV_ID + '/reply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: msg }),
      });

      if (res.ok) {
        input.value = '';
        const div = document.createElement('div');
        div.className = 'admin-thread-msg admin-thread-msg--admin';
        div.innerHTML =
          '<div class="admin-thread-msg__sender">👤 Administrator</div>' +
          '<div class="admin-thread-msg__bubble">' + escapeHtml(msg) + '</div>' +
          '<div class="admin-thread-msg__time">Just now</div>';
        thread.appendChild(div);
        thread.scrollTop = thread.scrollHeight;
      } else {
        alert('Could not send reply. Please try again.');
      }
    } catch (_e) {
      alert('Network error. Please try again.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Reply';
    }
  }

  async function closeConversation() {
    if (!confirm('Mark this conversation as closed?')) return;
    const btn = document.getElementById('closeConvBtn');
    btn.disabled = true;
    btn.textContent = 'Closing…';

    try {
      const res = await fetch('/admin/chat/' + CONV_ID + '/reply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: '__CLOSE__' }),
      });
      if (res.ok) {
        location.reload();
      } else {
        btn.disabled = false;
        btn.textContent = 'Mark as Closed';
      }
    } catch (_e) {
      btn.disabled = false;
      btn.textContent = 'Mark as Closed';
    }
  }

  // Scroll thread to bottom on load
  (function() {
    const t = document.getElementById('adminThread');
    if (t) t.scrollTop = t.scrollHeight;
  })();
  </script>
</body>
</html>
