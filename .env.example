# =============================================================
# CSPC Suggestion & Feedback System — Environment Variables
# =============================================================
#
# INSTRUCTIONS
# ------------
# 1. Copy this file to .env  (cp .env.example .env)
# 2. Fill in the values for your environment.
# 3. NEVER commit .env to Git — it is in .gitignore.
# 4. For production (Render), set these in the Render dashboard
#    under: Service → Environment → Environment Variables.
#    Do NOT upload a .env file to Render.
#
# =============================================================

# ---------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------

# LOCAL:      PORT=3000
# PRODUCTION: Render sets PORT automatically — do NOT override it.
PORT=3000

# LOCAL:      NODE_ENV=development
# PRODUCTION: NODE_ENV=production
NODE_ENV=development

# ---------------------------------------------------------------
# MySQL DATABASE
# ---------------------------------------------------------------

# LOCAL (XAMPP):
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASSWORD=          (empty for XAMPP default)
#   DB_NAME=cspc_feedback_db

# PRODUCTION (hosted MySQL — e.g. Filess.io, Clever Cloud):
#   DB_HOST=<your-hosted-mysql-host>
#   DB_PORT=<your-hosted-mysql-port>   (often 3306 or a custom port)
#   DB_USER=<your-hosted-mysql-user>
#   DB_PASSWORD=<your-hosted-mysql-password>
#   DB_NAME=<your-hosted-mysql-database-name>

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cspc_feedback_db

# ---------------------------------------------------------------
# SESSION
# ---------------------------------------------------------------

# Must be a long, random, secret string (at least 32 characters).
# LOCAL:      any dev string is fine
# PRODUCTION: generate a strong random value, e.g.:
#             node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ---------------------------------------------------------------
# Google OAuth — "Sign in with Google"
# Any successfully authenticated Google account is allowed.
# No email-domain restriction is applied.
#
# Get credentials from: https://console.cloud.google.com/
#   APIs & Services → Credentials → OAuth 2.0 Client IDs
# ---------------------------------------------------------------

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# LOCAL:
#   GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
#
# PRODUCTION — must be the HTTPS domain exactly as registered in
# Google Cloud Console → Authorized redirect URIs:
#   GOOGLE_CALLBACK_URL=https://cspcfeedbacksuggest.me/auth/google/callback

GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# ---------------------------------------------------------------
# Gemini AI — Aizen AI chatbot
# ---------------------------------------------------------------
# Get your key from: https://aistudio.google.com/app/apikey
# NEVER put the real key in .env.example or commit it to Git.
GEMINI_API_KEY=
